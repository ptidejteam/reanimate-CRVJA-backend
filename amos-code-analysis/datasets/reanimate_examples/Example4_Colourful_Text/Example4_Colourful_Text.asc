Screen Open 1,640,400,16,Hires
Curs Off

COLOUR=0

For I=0 To 35
    Paper COLOUR
    Ink COLOUR + 1

    Text 10,10,"Code Revival via JavaScript for AMOS"
    Text 20+I*10,20+I*10,"CRVJA Is Not AMOS"

    Wait 5

    COLOUR = COLOUR + 1
    If COLOUR > 14
        COLOUR = 0
    End If
Next
