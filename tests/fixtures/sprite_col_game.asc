Screen Open 0,320,200,16,Lowres
Load "tutorial_bank.abk",1
X=32

Text 8,8,"A/D: TOUCH THE TARGET"
Text 8,144,"ALL:"
Text 8,168,"RANGE:"

Do
  If Key State($1E)
    X=Max(0,X-2)
  End If
  If Key State($20)
    X=Min(288,X+2)
  End If

  Sprite 1,X,80,0
  Sprite 2,240,80,1

  ALL=Sprite Col(1)
  HIT=Sprite Col(1,2 To 2)
  Text 80,144,ALL
  Text 80,168,HIT

  If HIT=-1
    Text 8,112,"YOU WIN! MOVE AWAY TO RESET"
  Else
    Text 8,112,"MOVE INTO THE TARGET"
  End If
Loop
